# 复制为 .env 后按需修改。ADMIN_PASSWORD 与 ADMIN_API_TOKEN 至少配置一项。

TZ=Asia/Shanghai

# 管理鉴权（必填其一）
ADMIN_PASSWORD=change-me
ADMIN_API_TOKEN=change-me-admin-token

# （可选）字幕公开 API 鉴权
# PUBLIC_API_TOKEN=

# LLM 后处理（OpenAI 兼容；不配则跳过修正）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

WORK_CACHE_QUOTA_GB=2
STEP_CONCURRENCY_JSON={"download":1,"stt":1,"correct":1,"default":1}

# 访问 YouTube 等海外站点时可设代理；国内站点见 docker-compose 中 NO_PROXY
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890

# YouTube 限流
YTDLP_YOUTUBE_MIN_INTERVAL_SEC=6

LOG_LEVEL=INFO
LOG_FORMAT=text
